# Copy to .env (git-ignored) or set these as real environment variables.
# Real environment variables take precedence over .env.

# ---- AI interpretation (OpenAI-compatible API, e.g. an OpenAI Platform key) -------
# The key is read server-side only. It is never sent to the browser, logged, or written to outputs.
TWIN_AI_API_KEY=
# OPENAI_API_KEY is accepted as a fallback name.
TWIN_AI_BASE_URL=https://api.openai.com/v1
# Model id: run `python -m twin.ai.probe` once the key is set to list the models your key can use
# and to test image input + strict JSON output.
TWIN_AI_MODEL=
# "responses" (OpenAI Responses API) or "chat_completions"
TWIN_AI_API_STYLE=responses
# Optional: low | medium | high (only sent when set)
TWIN_AI_REASONING_EFFORT=
TWIN_AI_TIMEOUT_S=180
TWIN_AI_MAX_RETRIES=3
TWIN_AI_MAX_OUTPUT_TOKENS=20000
# Cost guard: max AI requests per UTC day across all projects
TWIN_AI_DAILY_REQUEST_LIMIT=200
# Hard spending cap in USD (all projects, all time). No request is sent unless its worst-case cost
# (input estimate + full output allowance) still fits. With a cap set, prices are REQUIRED.
TWIN_AI_BUDGET_USD=10
# USD per 1M tokens for TWIN_AI_MODEL, Standard tier (developers.openai.com/api/docs/pricing).
# Leave empty for a model in twin/config.py MODEL_PRICES (gpt-6.1-sol, gpt-5.6-sol, gpt-6-luna, gpt-5.3-codex):
# its published price is used. Any other model needs both values, or the spending cap sends nothing.
TWIN_AI_PRICE_INPUT_PER_1M=
TWIN_AI_PRICE_OUTPUT_PER_1M=
# Requests are pinned to this tier so billing matches the prices above ("Fast" costs 2x)
TWIN_AI_SERVICE_TIER=default
# AI problem solver ('Fix problems automatically' in Review, docs/PROBLEMS.md): same key and cap, its own model.
# Prices default for gpt-5.3-codex (1.75 / 14.00 per 1M, 2026-10-14); set both for any other model.
TWIN_AI_SOLVER_MODEL=gpt-5.3-codex
TWIN_AI_SOLVER_PRICE_INPUT_PER_1M=
TWIN_AI_SOLVER_PRICE_OUTPUT_PER_1M=
TWIN_AI_SOLVER_EFFORT=medium

# ---- Tools (auto-detected when empty) -----------------------------------------------------
TWIN_BLENDER_PATH=
TWIN_UNREAL_ENGINE_DIR=
TWIN_UNREAL_PROJECT=

# ---- Desktop viewer (packaged Unreal app, docs/UNREAL_VIEWER.md) ----------------------------------
# Secret that signs read-only viewer tokens (>= 32 chars). Empty = generated once into <data dir>/viewer_secret.key
TWIN_VIEWER_SECRET=
# Lifetime of a viewer link in hours (max 720)
TWIN_VIEWER_TOKEN_TTL_H=12
# Backend address written into launch files when the viewer runs on another PC (default: the URL the request used)
TWIN_PUBLIC_URL=
# "Open on this PC" (web app + backend on the same computer): the desktop viewer to start; empty = dist/TwinViewerShipping, else dist/TwinViewer
TWIN_DESKTOP_VIEWER_EXE=

# ---- Unreal walkthrough in the browser: local Pixel Streaming test (docs/PIXEL_STREAMING.md) ------
# 1 = show "Open in browser (Unreal)" on builds; viewer + signalling server run on this PC, 127.0.0.1 only
TWIN_STREAM_LOCAL=0
# Built SignallingWebServer folder of EpicGames/PixelStreamingInfrastructure (branch / release for UE 5.8)
TWIN_STREAM_SIGNALLING_DIR=
# Default: dist/TwinViewerStreaming/Windows/TwinWalkthrough/Binaries/Win64/TwinWalkthrough.exe
TWIN_STREAM_VIEWER_EXE=
TWIN_STREAM_MAX_SESSIONS=2
TWIN_STREAM_RES_X=1600
TWIN_STREAM_RES_Y=900
TWIN_STREAM_IDLE_EXIT_S=600
TWIN_STREAM_MAX_SESSION_S=3600

# ---- Server / storage ---------------------------------------------------------------------
TWIN_HOST=127.0.0.1
TWIN_PORT=8765
TWIN_DATA_DIR=
TWIN_MAX_UPLOAD_MB=25
TWIN_RENDER_PREVIEWS=1
